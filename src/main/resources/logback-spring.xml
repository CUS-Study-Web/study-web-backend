<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name"/>
    <springProperty scope="context" name="lokiUrl" source="logging.loki.url"/>

   <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>app=studyweb,log_type=activity,action=%X{action_type:-UNKNOWN}</pattern>
            </label>
            <message>
                <pattern>
                    {
                      "timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}",
                      "userId": "%X{user_id}",
                      "actionType": "%X{action_type:-UNKNOWN}",
                      "description": "%message"
                    }
                </pattern>
            </message>
        </format>
     </appender>

    <logger name="ACTIVITY_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="LOKI" />
    </logger>

     <root level="INFO">
        <appender-ref ref="CONSOLE" />
     </root>
</configuration>
